#!/bin/sh
# Runs a request from the guest, as the same user. The guest's hostcall sends
# "DIR REQUEST [ARG...]", each word single-quoted, over ssh. Requests:
#   exec PROGRAM [ARG...]   run a Windows program in DIR
#   wslpath [ARG...]        translate a path, as wslpath(1) in DIR
#   ports [HOST:PORT...]    forward these guest TCP ports (root only)
#   time                    print the time in seconds since the epoch
# shellcheck source=common
. /usr/libexec/wsnetbsd/common

eval "set -- ${SSH_ORIGINAL_COMMAND:-}"
[ $# -ge 2 ] || { echo "hostcall: no request" >&2; exit 2; }
dir=$1
request=$2
shift 2

# Only /mnt and a user's home, which vmctl mounts from the guest, are the same
# directories in Alpine as in the guest. Elsewhere Windows programs start in
# the home directory.
enter_dir() {
	case $dir in
	/mnt/*) cd "$dir" 2>/dev/null && return ;;
	/home/"$(id -un)"|/home/"$(id -un)"/*) cd "$dir" 2>/dev/null && return ;;
	esac
	cd "$HOME" 2>/dev/null || cd /
}

# forward OPTION...: sends a control command to the ssh connection that
# carries forwarded ports.
forward() { ssh_guest root -S "$FORWARD_CTL" "$@" netbsd; }

case $request in
exec)
	[ $# -ge 1 ] || { echo "hostcall: exec needs a program" >&2; exit 2; }
	program=$1
	shift
	case $program in
	*/*) path=$program ;;
	*)
		path=$(tr : '\n' < "$HOSTDIR/winpath" 2>/dev/null | while read -r d; do
			[ -f "$d/$program" ] && { printf %s "$d/$program"; break; }
		done)
		;;
	esac
	[ -n "$path" ] || { echo "$program: not found on the Windows PATH" >&2; exit 127; }
	use_interop
	enter_dir
	exec "$path" "$@"
	;;
wslpath)
	enter_dir
	exec wslpath "$@"
	;;
ports)
	# Each HOST:PORT is where a guest program listens, as seen from inside the
	# guest. The forwards go over ssh, so the guest's sshd opens each
	# connection from inside the guest and reaches programs that listen only
	# on its localhost. QEMU's own forwarding cannot.
	[ "$(id -u)" = 0 ] || { echo "hostcall: ports is for root" >&2; exit 1; }
	if ! forward -O check 2>/dev/null; then
		rm -f "$RUN/ports" "$FORWARD_CTL"
		# Its output would hold the guest's connection open.
		ssh_guest root -M -S "$FORWARD_CTL" -f -N -o ServerAliveInterval=5 netbsd \
			</dev/null >/dev/null 2>&1 || exit 1
	fi
	want=
	for spec; do
		case ${spec%:*} in 127.0.0.1|10.0.2.15|'[::1]') ;; *) continue ;; esac
		port=${spec##*:}
		case $port in ''|*[!0-9]*) continue ;; esac
		case " $NO_FORWARD_PORTS " in *" $port "*) continue ;; esac
		want="$want $spec"
	done
	have=$(cat "$RUN/ports" 2>/dev/null)
	kept=
	rc=0
	for spec in $have; do
		case " $want " in
		*" $spec "*) kept="$kept $spec" ;;
		*) forward -O cancel -L "127.0.0.1:${spec##*:}:$spec" ;;
		esac
	done
	# A port another distribution already listens on fails, and the guest
	# tries it again on its next call.
	for spec in $want; do
		case " $have " in *" $spec "*) continue ;; esac
		if forward -O forward -L "127.0.0.1:${spec##*:}:$spec"; then
			kept="$kept $spec"
		else
			rc=1
		fi
	done
	printf '%s\n' "${kept# }" > "$RUN/ports"
	exit "$rc"
	;;
time)
	date +%s
	;;
*)
	echo "hostcall: unknown request $request" >&2
	exit 2
	;;
esac
