#!/bin/sh
# Login shell of WSL users in the Alpine layer. WSL runs this for `NetBSD.exe`
# and `wsl -d NetBSD <command>`, and it hands the session to the guest.
# `wsl -d NetBSD -e /bin/sh` bypasses it and reaches Alpine.

# shellcheck source=common
. /usr/libexec/wsnetbsd/common

command=
has_command=0
while [ $# -gt 0 ]; do
	case $1 in
	-c) has_command=1; command=${2:-}; break ;;
	-l|-i|--login) shift ;;
	*) break ;;
	esac
done

# sshd runs the guest's calls into Alpine through this shell too.
if [ -n "${SSH_CONNECTION:-}" ] && [ "$command" = /usr/libexec/wsnetbsd/hostcall ]; then
	exec /usr/libexec/wsnetbsd/hostcall
fi

# Survive Ctrl-C and a closed terminal long enough to deregister the session.
# Unlike ignoring them, a trap leaves the signals at their default in ssh.
trap : INT TERM HUP

session_begin || exit 1

user=$(id -un)
if [ "$user" = root ] && [ "$has_command" = 0 ] && [ ! -e "$STATE/oobe-done" ] && [ -t 0 ]; then
	/usr/libexec/wsnetbsd/oobe && user=$(cat "$STATE/oobe-done")
	[ -n "$user" ] || user=root
fi
if [ ! -r "$KEYS/$user" ]; then
	echo "wsnetbsd: $user has no NetBSD account. As root, run: /usr/libexec/wsnetbsd/adduser $user" >&2
	echo "(wsl -d ${WSL_DISTRO_NAME:-NetBSD} -u root -e /usr/libexec/wsnetbsd/adduser $user)" >&2
	session_end
	exit 1
fi

# Variables WSLENV shares with Linux, plus ones that describe the terminal.
env=
for name in $(printf %s "${WSLENV:-}" | tr : '\n' | sed 's|/.*||') \
	WSLENV WSL_DISTRO_NAME WT_SESSION WT_PROFILE_ID COLORTERM TERM_PROGRAM TERM_PROGRAM_VERSION; do
	case $name in ''|*[!A-Za-z0-9_]*|[0-9]*) continue ;; esac
	eval "[ -n \"\${$name+x}\" ]" || continue
	value=
	eval "value=\$$name"
	env="${env}export $name=$(quote "$value"); "
done
# WSLg's X server and sound server, which QEMU relays from 10.0.2.100.
[ -S /tmp/.X11-unix/X0 ] && env="${env}export DISPLAY=10.0.2.100:0; "
[ -S /mnt/wslg/PulseServer ] && env="${env}export PULSE_SERVER=tcp:10.0.2.100:4713; "

cd_guest="cd $(quote "$PWD") 2>/dev/null || cd"
if [ "$has_command" = 1 ]; then
	remote="$env$cd_guest; $command"
	if [ -t 0 ] && [ -t 1 ]; then tty=-tt; else tty=-T; fi
else
	remote="$env$cd_guest; exec \${SHELL:-/bin/sh} -l"
	tty=-tt
fi

ssh_guest "$user" "$tty" netbsd "$remote"
rc=$?
session_end
exit "$rc"
