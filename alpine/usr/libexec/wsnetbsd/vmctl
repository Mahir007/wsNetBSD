#!/bin/sh
# Manages the NetBSD VM. A single root monitor, started from wsl.conf, owns the
# VM's lifetime. Login shells only register a session file and wait for $READY.
set -eu

# shellcheck source=common
. /usr/libexec/wsnetbsd/common

LIB=/usr/lib/wsnetbsd
HOST_KEY=$STATE/ssh_host_ed25519_key

memory_mib() {
	total=$(awk '/^MemTotal:/ { print int($2 / 1024) }' /proc/meminfo)
	half=$((total / 2))
	if [ "$half" -gt "$MAX_MEMORY_MIB" ]; then echo "$MAX_MEMORY_MIB"; else echo "$half"; fi
}

# Prints a TCP port from 22022 up that nothing listens on. All WSL
# distributions share one network namespace, so another NetBSD distribution
# may hold 22022.
free_port() {
	port=22022
	while awk -v p=":$(printf %04X "$port")" '
		$4 == "0A" && substr($2, length($2) - 4) == p { found = 1 }
		END { exit !found }' /proc/net/tcp /proc/net/tcp6 2>/dev/null; do
		port=$((port + 1))
	done
	echo "$port"
}

# le16 N: prints N as two bytes, low byte first.
# shellcheck disable=SC2059 # the format is the octal escapes
le16() { printf "\\$(printf %03o $(($1 & 255)))\\$(printf %03o $(($1 >> 8)))"; }

# Writes SMBIOS tables for QEMU's firmware to install. NetBSD shows them as
# machdep.dmi.*, and fastfetch's Host line names WSL, as it does for Linux
# distributions. The firmware adds its own BIOS table, fills in the table
# address and fixes both checksums.
write_smbios() {
	product="Windows Subsystem for Linux - ${WSL_DISTRO_NAME:-NetBSD}"
	version=$(wslinfo --wsl-version 2>/dev/null) || version=
	# Type 1, the system: strings for the vendor, product and version, no
	# serial number, a zero UUID, woken by the power switch.
	{
		printf '\001\031'
		le16 256
		if [ -n "$version" ]; then printf '\001\002\003\000'; else printf '\001\002\000\000'; fi
		printf '\000\000\000\000\000\000\000\000\000\000\000\000\000\000\000\000\006'
		printf '%s\000' QEMU "$product"
		[ -z "$version" ] || printf '%s\000' "$version"
		printf '\000'
	} > "$RUN/smbios-tables"
	# NetBSD copies 128 bytes from the start of a string and ignores the
	# string unless that much of the tables follows it. Type 126, an inactive
	# structure that readers skip, pads them out. Type 127 ends them.
	{
		printf '\176\204'
		le16 512
		printf '\000%.0s' $(seq 130)
		printf '\177\004\000\177\000\000'
	} >> "$RUN/smbios-tables"
	# The SMBIOS 2.8 entry point, in its 32-bit form, which the firmware reads.
	# The largest structure is the padding, 134 bytes.
	{
		printf '_SM_\000\037\002\010'
		le16 134
		printf '\000\000\000\000\000\000_DMI_\000'
		le16 "$(wc -c < "$RUN/smbios-tables")"
		printf '\000\000\000\000'
		le16 3
		printf '\050'
	} > "$RUN/smbios-anchor"
}

boot_vm() {
	if [ ! -c /dev/kvm ]; then
		echo "wsnetbsd: /dev/kvm is missing. NetBSD needs WSL 2 with nested virtualization." >&2
		return 1
	fi
	mkdir -p "$KEYS"
	[ -f "$KEYS/root" ] || ssh-keygen -q -t ed25519 -N '' -C root@wsnetbsd -f "$KEYS/root"
	[ -f "$HOST_KEY" ] || ssh-keygen -q -t ed25519 -N '' -f "$HOST_KEY"
	hostname > "$HOSTDIR/hostname"

	: > "$RUN/console.log"
	rm -f "$RUN/ports" "$FORWARD_CTL"
	write_smbios
	ssh_port=$(free_port)
	echo "$ssh_port" > "$SSH_PORT_FILE"
	# The guest reaches Alpine at 10.0.2.100, where QEMU starts a program for
	# each connection: on port 22 an sshd that runs Windows programs and
	# forwards ports for the guest, on 6000 and 4713 a relay to WSLg's X
	# server and sound server.
	net="user,id=net0,ipv6=off,hostfwd=tcp:127.0.0.1:$ssh_port-:22"
	net="$net,guestfwd=tcp:10.0.2.100:22-cmd:/usr/sbin/sshd -i -f $LIB/sshd_config"
	net="$net,guestfwd=tcp:10.0.2.100:6000-cmd:/usr/bin/nc -N -U /tmp/.X11-unix/X0"
	net="$net,guestfwd=tcp:10.0.2.100:4713-cmd:/usr/bin/nc -N -U /mnt/wslg/PulseServer"
	# Right after `wsl --terminate`, the last run's QEMU can hold the disk's
	# lock for a moment while its writes drain.
	n=0
	until "$LIB/qemu-system-x86_64" -L "$LIB" \
		-M microvm,x-option-roms=off,rtc=on,acpi=off,pic=off,accel=kvm \
		-m "$(memory_mib)" -smp "$(nproc)" -cpu host,+invtsc \
		-kernel "$LIB/kernel" -append "root=ld0a console=com" \
		-fw_cfg name=etc/smbios/smbios-anchor,file="$RUN/smbios-anchor" \
		-fw_cfg name=etc/smbios/smbios-tables,file="$RUN/smbios-tables" \
		-global virtio-mmio.force-legacy=false \
		-device virtio-blk-device,drive=root \
		-drive file="$IMAGE",format=qcow2,if=none,id=root,cache=writeback,aio=threads,discard=unmap,detect-zeroes=unmap \
		-device virtio-net-device,netdev=net0 \
		-netdev "$net" \
		-fsdev local,id=host,path="$HOSTDIR",security_model=none,readonly=on \
		-device virtio-9p-device,fsdev=host,mount_tag=host \
		-fsdev local,id=mnt,path=/mnt,security_model=none,multidevs=remap \
		-device virtio-9p-device,fsdev=mnt,mount_tag=mnt \
		-device virtio-rng-device \
		-chardev "socket,id=con,path=$RUN/console.sock,server=on,wait=off,logfile=$RUN/console.log" \
		-serial chardev:con \
		-display none -nodefaults \
		-daemonize -pidfile "$RUN/qemu.pid" 9>&-
	do
		n=$((n + 1))
		[ "$n" -lt 10 ] || return 1
		sleep 1
	done
}

start_vm() {
	running || boot_vm
	n=0
	until ssh_guest root -n netbsd true 2>/dev/null; do
		n=$((n + 1))
		[ "$n" -lt 600 ] || { echo "wsnetbsd: VM did not come up, see $RUN/console.log" >&2; return 1; }
		sleep 0.1
	done
	: > "$READY"
}

stop_vm() {
	rm -f "$READY"
	unmount_homes
	ssh_guest root -S "$FORWARD_CTL" -O exit netbsd >/dev/null 2>&1 || true
	running || return 0
	# shutdown(8) sleeps for several seconds, which loses the race against WSL
	# stopping the distro 15 s after the last session ends. The halt runs
	# detached because a halted guest never closes the ssh connection.
	ssh_guest root -n netbsd '(sh /etc/rc.shutdown; /sbin/halt -lq) </dev/null >/dev/null 2>&1 &' >/dev/null 2>&1 || true
	n=0
	# microvm has no ACPI, so the guest halts but cannot power the VM off.
	while [ "$n" -lt 120 ] && running && ! grep -q 'operating system has halted' "$RUN/console.log"; do
		sleep 0.25
		n=$((n + 1))
	done
	running && kill "$(cat "$RUN/qemu.pid")"
	rm -f "$RUN/qemu.pid" "$RUN/ports"
}

# Mounts the NetBSD home of each user with a session over their Alpine home,
# so Windows sees it at \\wsl.localhost\DISTRO\home\USER.
mount_homes() {
	for s in "$SESSIONS"/*; do
		[ -e "$s" ] || continue
		user=$(stat -c %U "$s")
		home=/home/$user
		[ "$user" != root ] && [ -f "$KEYS/$user" ] && [ -d "$home" ] || continue
		grep -q " $home fuse.sshfs " /proc/mounts && continue
		sshfs -F /dev/null -p "$(cat "$SSH_PORT_FILE")" \
			-o IdentityFile="$KEYS/$user",BatchMode=yes,LogLevel=ERROR \
			-o StrictHostKeyChecking=no,UserKnownHostsFile=/dev/null \
			-o ServerAliveInterval=5,reconnect,allow_other,default_permissions,idmap=none \
			"$user@127.0.0.1:$home" "$home" 9>&- ||
			echo "wsnetbsd: could not mount the NetBSD $home" >&2
	done
}

unmount_homes() {
	awk '$3 == "fuse.sshfs" { print $2 }' /proc/mounts | while read -r m; do
		fusermount3 -uz "$m" || true
	done
}

# Drops session files left by a login shell that was killed.
prune_sessions() {
	for s in "$SESSIONS"/*; do
		[ -e "$s" ] || continue
		kill -0 "${s##*/}" 2>/dev/null || rm -f "$s"
	done
}

# should_stop IDLE_SECONDS: halt the guest now that no sessions are attached?
# WSL kills the distro 15 s after its last session ends, and a halt takes
# about 3 s. Halting first saves the next boot a journal replay.
should_stop() { [ "$1" -ge "$IDLE_HALT_SECONDS" ]; }

# Makes the user oobe created the distro's default. WSL stops the distro to
# apply it, so this runs only after an idle halt.
apply_default_user() {
	[ -f "$STATE/default-user" ] || return 0
	read -r name distro < "$STATE/default-user"
	rm -f "$STATE/default-user"
	use_interop || true
	/mnt/c/Windows/System32/wsl.exe --manage "$distro" --set-default-user "$name" ||
		echo "wsnetbsd: could not make $name the default user" >&2
}

# link_windows_programs PATH: gives each .exe on the Windows PATH a script in
# the directory the guest sees as /.wsl/bin, which runs the guest's winexec
# with the script's name. They are hard links to one script: the guest's 9p
# client cannot follow symlinks.
link_windows_programs() {
	new=$HOSTDIR/bin.new
	rm -rf "$new"
	mkdir "$new"
	stub=$new/.winexec
	# shellcheck disable=SC2016 # the stub expands these
	printf '#!/bin/sh\nexec /usr/local/bin/winexec "${0##*/}" "$@"\n' > "$stub"
	chmod 755 "$stub"
	printf %s "$1" | tr : '\n' | while read -r dir; do
		for exe in "$dir"/*.exe; do
			[ -e "$exe" ] || continue
			[ -e "$new/${exe##*/}" ] || ln "$stub" "$new/${exe##*/}" || true
		done
	done
	printf '%s\n' "$1" > "$HOSTDIR/winpath"
	rm -rf "${HOSTDIR:?}/bin"
	mv "$new" "$HOSTDIR/bin"
}

# Relinks Windows programs once per distro start, to pick up new ones, and
# again whenever a session brings a different Windows PATH.
refresh_windows_programs() {
	# shellcheck disable=SC2012 # session files are named by pid
	newest=$(ls -t "$SESSIONS" | head -n 1)
	[ -n "$newest" ] || return 0
	path=$(head -n 1 "$SESSIONS/$newest" 2>/dev/null) || return 0
	[ -n "$path" ] || return 0
	[ "$path" != "$(cat "$RUN/winpath" 2>/dev/null)" ] || return 0
	printf '%s\n' "$path" > "$RUN/winpath"
	link_windows_programs "$path" >> "$RUN/monitor.log" 2>&1 9>&- &
}

cmd_monitor() {
	# Only one monitor may own the VM. Children close the lock's descriptor so
	# it dies with the monitor.
	exec 9> "$RUN/monitor.lock"
	flock -n 9 || { echo "wsnetbsd: a monitor is already running" >&2; exit 0; }
	mkdir -p "$SESSIONS"
	chmod 1777 "$SESSIONS"
	# Login shells watch for $FAILED so they report a dead monitor immediately.
	trap '[ -f "$READY" ] || : > "$FAILED"' EXIT
	# The VM boots for the first session, so `wsl -e` into Alpine does not
	# start it.
	idle=0
	seen=
	while :; do
		# QEMU can die without stop_vm: a crash, or a kill from outside.
		running || rm -f "$READY"
		prune_sessions
		sessions=$(ls -A "$SESSIONS")
		if [ -n "$sessions" ]; then
			idle=0
			running || start_vm
			if [ "$sessions" != "$seen" ]; then
				refresh_windows_programs
				mount_homes
			fi
		elif running; then
			idle=$((idle + 1))
			if should_stop "$((idle / 4))"; then
				stop_vm
				idle=0
				apply_default_user
			fi
		fi
		seen=$sessions
		# The idle count assumes 0.25 s. With no VM, a shorter wait boots it
		# sooner for a new session.
		if running; then sleep 0.25; else sleep 0.05; fi
	done
}

case ${1:-} in
boot)
	mkdir -p "$RUN"
	# Leave a running monitor and its log alone.
	flock -n "$RUN/monitor.lock" true || exit 0
	setsid "$0" monitor > "$RUN/monitor.log" 2>&1 < /dev/null &
	;;
monitor) cmd_monitor ;;
stop) stop_vm ;;
status) if running; then echo running; else echo stopped; exit 1; fi ;;
*) echo "usage: vmctl boot|stop|status" >&2; exit 2 ;;
esac
