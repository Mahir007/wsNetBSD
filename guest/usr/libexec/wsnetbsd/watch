#!/bin/sh
# Runs as root for as long as the guest is up. Forwards TCP ports that guest
# programs listen on to Windows localhost, and resets the clock when it drifts,
# as it does after Windows sleeps.
hostcall=/usr/libexec/wsnetbsd/hostcall

# Prints HOST:PORT for each listening port, HOST being where to reach it from
# inside the guest. A port open on IPv4 and IPv6 is reached over IPv4.
listening() {
	{ netstat -an -f inet; netstat -an -f inet6; } 2>/dev/null | awk '
	function reach(port, host, rank) {
		if (!(port in best) || rank < best[port]) { best[port] = rank; to[port] = host }
	}
	$1 ~ /^tcp/ && $NF == "LISTEN" {
		port = $4; sub(/.*\./, "", port)
		addr = $4; sub(/\.[0-9]+$/, "", addr)
		if ($1 == "tcp6") { if (addr == "*" || addr == "::1") reach(port, "[::1]", 3) }
		else if (addr == "*" || addr == "127.0.0.1") reach(port, "127.0.0.1", 1)
		else if (addr == "10.0.2.15") reach(port, addr, 2)
	}
	END { for (p in to) print to[p] ":" p }' | sort | xargs
}

sync_clock() {
	host=$($hostcall time) || return
	drift=$((host - $(date +%s)))
	[ "${drift#-}" -gt 2 ] || return
	date -u "$(date -u -r "$host" +%Y%m%d%H%M.%S)" >/dev/null &&
		logger -t wsnetbsd "clock was ${drift}s off, reset from Windows"
}

ports=
n=0
while :; do
	now=$(listening)
	# Sent again every 30 s, in case Alpine lost the forwards. That also
	# retries a port another WSL distribution held at the last call.
	if [ "$now" != "$ports" ] || [ $((n % 30)) = 0 ]; then
		# shellcheck disable=SC2086 # one argument per port
		$hostcall ports $now
		ports=$now
	fi
	[ $((n % 30)) != 0 ] || sync_clock
	n=$((n + 1))
	sleep 1
done
