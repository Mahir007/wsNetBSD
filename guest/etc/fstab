# log journals metadata, so the file system stays consistent when WSL stops
# the VM without warning. NetBSD ignores discard on a journaled file system.
/dev/ld0a  /         ffs     rw,log,noatime  1 1
ptyfs      /dev/pts  ptyfs   rw              0 0
kernfs     /kern     kernfs  rw              0 0
procfs     /proc     procfs  rw              0 0
tmpfs      /tmp      tmpfs   rw,-m=1777      0 0
tmpfs      /var/shm  tmpfs   rw,-m=1777      0 0
